# ---------------------------------------------------------------------------
# Local development template. Copy to .env (git-ignored) and fill in.
# Keep this file free of real values -- it is committed.
#
# Nothing here is needed when deployed: app.yaml reads the connection string
# from a Databricks secret. See README "Setup you still need to do".
# ---------------------------------------------------------------------------

# --- Option 1: connection string (what you are using) ----------------------
# Paste your Lakebase connection string into .env, NOT into this file.
#   postgresql://<user>:<password>@<host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require
#
# If the password contains any of  @ : / ? # %  it must be percent-encoded
# (@ -> %40, : -> %3A, / -> %2F, ? -> %3F, # -> %23, % -> %25).
LAKEBASE_URL=

# --- Option 2: OAuth instead of a password ---------------------------------
# Leave LAKEBASE_URL empty and set these to have the app mint short-lived
# tokens from your Databricks login (`databricks auth login --host <url>`).
# DATABRICKS_HOST=
# DATABRICKS_CONFIG_PROFILE=DEFAULT
# LAKEBASE_INSTANCE_NAME=
# PGHOST=
# PGPORT=5432
# PGDATABASE=databricks_postgres
# PGUSER=
# PGSSLMODE=require

# --- App behaviour ---------------------------------------------------------
LAKEBASE_SCHEMA=support
# Create the schema/tables on boot when they do not exist yet.
LAKEBASE_AUTO_MIGRATE=true
# Insert demo tickets/messages only while the tickets table is empty.
LAKEBASE_SEED_ON_EMPTY=true
APP_BRAND_NAME=Nexus Support
# Fallback identity when no Databricks user header is present (local dev).
APP_DEFAULT_USER=local.dev@example.com
PORT=8000
FLASK_DEBUG=false
